# Supabase - copie para .env e preencha com os valores do seu projeto
# Em Supabase: Project Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# URL de retorno para o app nativo (Flutter)
# Usado no botão "Voltar ao início" após confirmação de pagamento
# Pode ser: custom scheme, universal link ou app link
#
# Exemplos:
#   runlab://payment-success                      (custom URL scheme)
#   https://app.runlab.com.br/payment-success     (Universal Link iOS / App Link Android)
#
# Query params enviados automaticamente:
#   ?status=success&plan=avulsa&planName=CHALLENGE+TICKET&planType=Avulso&amount=59.90&paymentId=pay_xxx&paymentMethod=credito
#
# Se vazio, o botão navega para /corredor/planos (fallback web)
VITE_APP_RETURN_URL=runlab://payment-success
