# Supabase - copie para .env e preencha com os valores do seu projeto
# Em Supabase: Project Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-publishable-key-aqui

# URL de retorno para o app nativo (Flutter)
# Pode ser deep link (runlab://), universal link (https://app.runlab.com.br/), ou custom scheme
# Exemplos:
#   runlab://payment-callback                     (custom URL scheme)
#   https://app.runlab.com.br/payment-callback    (Universal Link iOS / App Link Android)
#
# Query params enviados automaticamente:
#   ?status=success&plan=avulsa&planName=CHALLENGE+TICKET&planType=Avulso&amount=59.90&paymentId=pay_xxx&paymentMethod=credito
#
# Se vazio, o botão navega para /corredor/planos (fallback web)
VITE_APP_RETURN_URL=runlab://payment-callback
