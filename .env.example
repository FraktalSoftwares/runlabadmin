# Supabase - copie para .env e preencha com os valores do seu projeto
# Em Supabase: Project Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-publishable-key-aqui

# URL do app de checkout. Corredor que loga aqui é redirecionado pra lá.
# Default em produção: https://checkout.runlab.com.br
# Em dev: http://localhost:8080
VITE_CHECKOUT_URL=https://checkout.runlab.com.br
